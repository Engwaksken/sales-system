APP_NAME="Kemmytech Sales"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kemmytec_sales
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Mobile money / iotec collections (see App\Http\Controllers\IotecCollectionsController)
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_BASE_URL=

# EFRIS (Uganda URA e-invoicing) — see efris_config / efris_devices modules
EFRIS_ENVIRONMENT=sandbox
